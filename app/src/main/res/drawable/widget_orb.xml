<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- outer glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="50%"
                android:startColor="#9900C8FF"
                android:centerColor="#3300A0FF"
                android:endColor="#000066CC" />
        </shape>
    </item>

    <!-- HUD ring -->
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#AA7FDBFF" />
        </shape>
    </item>

    <!-- bright core -->
    <item
        android:left="22dp"
        android:top="22dp"
        android:right="22dp"
        android:bottom="22dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="50%"
                android:startColor="#FFFFFFFF"
                android:centerColor="#FF4FD8FF"
                android:endColor="#FF0460B8" />
        </shape>
    </item>
</layer-list>
